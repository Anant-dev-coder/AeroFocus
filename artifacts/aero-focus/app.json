{
  "expo": {
    "name": "AeroFocus",
    "slug": "aero-focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aero-focus",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "splash": {
      "backgroundColor": "#080B08",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
