# Local development toggle for the safe mock auth fallback.
# Turn this off or remove it for production.
EXPO_PUBLIC_ENABLE_MOCK_AUTH=true

# Real app values for production auth.
# Update these to your actual backend and OIDC provider.
EXPO_PUBLIC_API_BASE_URL=https://your-api-server.com
EXPO_PUBLIC_REPL_ID=your_actual_oidc_client_id
EXPO_PUBLIC_ISSUER_URL=https://replit.com/oidc
